NEXT_PUBLIC_SITE_URL=http://localhost:7485
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_VK_PIXEL_ID=

# Legal readiness. Keep event registration closed until all values are set.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_INN=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=

# Required primary lead storage. Point this only to the approved production backend.
# header_hmac keeps the signature in HTTP headers.
# apps_script_body_hmac keeps the exact signed payload + HMAC inside a JSON wrapper because Apps Script web apps do not expose arbitrary request headers to doPost(e).
LEAD_STORAGE_TRANSPORT=header_hmac
LEAD_STORAGE_WEBHOOK_URL=
LEAD_STORAGE_WEBHOOK_SECRET=

# Optional privacy-safe conversion event sink. No name/phone/email is sent here.
ANALYTICS_WEBHOOK_URL=

# Optional PII mirror / privacy-safe operational notification.
# Configure a Sheets mirror only after its data-processing/legal path is approved.
GOOGLE_SHEETS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
